# Backend Environment Configuration Example

# Allowed CORS origins for production (comma-separated list of allowed URLs)
# Default (if unconfigured): http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Production Writable Storage Paths & Database Configuration
# Default local database (if DATABASE_URL is not set): SQLite at backend/data/insightiq.db
# UPLOADS_DIR_PATH=/tmp/insightiq-uploads
# DB_PATH=/tmp/insightiq.db

# Database Connection URL:
# For production (e.g. Supabase / Managed PostgreSQL):
# DATABASE_URL=postgresql://postgres.user:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# For SQLite (local default):
# DATABASE_URL=sqlite:///backend/data/insightiq.db

# LLM / AI Configuration
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2:3b
OLLAMA_HOST=http://localhost:11434
