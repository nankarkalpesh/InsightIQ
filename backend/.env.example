# Backend Environment Configuration Example

# Allowed CORS origins for production (comma-separated list of allowed URLs)
# Default (if unconfigured): http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Production Writable Storage Paths (e.g. for Render / Cloud hosting)
# Default (if unconfigured): backend/data/uploads and backend/data/insightiq.db
# In production on Render/PaaS, set these to writable paths like /tmp:
# UPLOADS_DIR_PATH=/tmp/insightiq-uploads
# DB_PATH=/tmp/insightiq.db
# Or specify full database URL:
# DATABASE_URL=sqlite:////tmp/insightiq.db

# LLM / AI Configuration
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2:3b
OLLAMA_HOST=http://localhost:11434
